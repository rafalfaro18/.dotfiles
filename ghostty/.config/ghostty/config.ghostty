font-family = "JetBrainsMonoNL Nerd Font Mono"
font-size = 13
theme = "TokyoNight Night"
background-image = ~/Pictures/wallhaven-vgyyxl.png
# Scale the image to completely cover the terminal window
background-image-fit = cover
# Center the image to prevent uneven clipping (optional but recommended)
background-image-position = top-right
background-image-opacity = 0.2
maximize = true
window-theme = dark
window-decoration = false
custom-shader = ~/.config/ghostty/shaders/cursor_warp.glsl
#custom-shader = ~/.config/ghostty/shaders/bettercrt.glsl
